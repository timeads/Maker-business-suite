# Copy to .env.local (never committed). Values come from the Supabase project
# for the environment you're running against.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin of this deployment, no trailing slash. Used for sign-in
# redirects and invite links. Optional locally (falls back to the request host).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Who runs this deployment, printed on the public /privacy and /terms pages.
# Until one is set, the page shows a labelled blank ("[contact address not
# set]") in its place. Read when the site is built: redeploy after changing.
# Have both pages reviewed by a lawyer before relying on them.
# The business's legal name, e.g. the name on its registration.
NEXT_PUBLIC_LEGAL_NAME=
# Its postal address, on one line.
NEXT_PUBLIC_LEGAL_ADDRESS=
# Where privacy and legal questions go. Use a role address, not a personal one.
NEXT_PUBLIC_CONTACT_EMAIL=
# Whose law governs the terms, worded to follow "the laws of …".
NEXT_PUBLIC_LEGAL_GOVERNING_LAW=
# The day the current wording took effect, as YYYY-MM-DD.
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=

# Optional: send invite emails through Postmark. Without these, the app shows
# a copyable invite link instead.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) ---

# Supabase → Project Settings → API keys → secret key. Used by the Stripe
# webhook, the worker and billing actions. Bypasses row-level security.
SUPABASE_SECRET_KEY=

# Stripe → Developers → API keys. Use test-mode keys outside production.
# Billing pages show "not switched on" until this is set.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <site>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Bookings: lets a business connect its own Stripe account so booking payments
# go straight to it. Stripe → Settings → Connect → Onboarding options → OAuth:
# copy the client id (ca_...) and allow the redirect URL
# <site>/api/connections/stripe/callback
STRIPE_CONNECT_CLIENT_ID=
# Signing secret of a second webhook endpoint, <site>/api/webhooks/stripe-connect,
# set to listen to events on Connected accounts: checkout.session.completed,
# checkout.session.expired, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed and account.application.deauthorized
STRIPE_CONNECT_WEBHOOK_SECRET=

# Shopify Partner dashboard → your public app → client credentials.
# Redirect URL to allow: <site>/api/connections/shopify/callback
# Privacy (compliance) webhook URLs: <site>/api/webhooks/shopify for all three.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: extra scopes Shopify has approved for the app, comma separated.
# Without read_all_orders, Shopify only returns the last 60 days of orders.
SHOPIFY_EXTRA_SCOPES=
# Optional; defaults to the version the adapter was written against.
SHOPIFY_API_VERSION=

# Intuit developer portal → your app → keys.
# Redirect URI to allow: <site>/api/connections/quickbooks/callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# "sandbox" (default) or "production"
QUICKBOOKS_ENVIRONMENT=sandbox

# Stock: lets a business connect its own Gmail so purchase orders can be
# emailed to suppliers from it. Optional: while these are unset, the Gmail
# connection isn't offered and nothing else changes. A Google Cloud project
# with the Gmail API switched on and a "Web application" OAuth client; the
# only Gmail permission asked for is gmail.send. See docs/gmail-orders.md.
# Redirect URI to allow: <site>/api/connections/google_mail/callback
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=

# Social and the help desk: a Meta (Facebook) app with Facebook Login for
# Business. A login only asks for what a workspace switches on, so the app
# needs only the permissions of the features you offer (docs/meta-messages.md
# lists which Meta "use case" carries each): posting (pages_manage_posts,
# instagram_content_publish), messages (pages_messaging,
# instagram_manage_messages) and comments (pages_manage_engagement,
# pages_read_user_content, instagram_manage_comments). Each needs App Review
# before people outside the app's own team can connect.
# Redirect URI to allow: <site>/api/connections/meta/callback
META_APP_ID=
META_APP_SECRET=
# Optional; defaults to the Graph API version the adapter was written against.
META_API_VERSION=
# Help desk: Instagram and Facebook messages (docs/meta-messages.md). A long
# random string you choose; type the same one into the Meta app's Webhooks
# screen as the "Verify token". The callback URL there is
# <site>/api/webhooks/meta, and deliveries are checked with META_APP_SECRET.
# Web service only. The worker needs META_APP_ID and META_APP_SECRET as well.
# Leave unset and messages simply aren't offered.
META_WEBHOOK_VERIFY_TOKEN=

# Social: posting straight to TikTok and LinkedIn through our own apps. Each
# is optional: while its two keys are unset it isn't offered and nothing else
# changes. Set them on BOTH the web and worker services. Setup steps, and
# what to check before going live, are in docs/tiktok-linkedin.md.
# TikTok developer portal → your app (Login Kit + Content Posting API).
# Redirect URI to allow: <site>/api/connections/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# "true" once TikTok has audited the app for direct post. Until then every
# video goes up as "Only you", and the composer says so.
TIKTOK_APP_AUDITED=
# Optional: "base64url" if TikTok refuses the sign-in's PKCE challenge
# (the default is hex, as TikTok's own pages describe it).
TIKTOK_PKCE_ENCODING=
# LinkedIn developer portal → your app → Auth.
# Redirect URL to allow: <site>/api/connections/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# "true" once LinkedIn has approved the app for its Community Management API:
# sign-in then also asks to post as the company pages a person looks after.
LINKEDIN_COMPANY_PAGES=
# Optional: the LinkedIn-Version header, YYYYMM. LinkedIn retires each
# version about a year after release; keep it current.
LINKEDIN_API_VERSION=

# Help desk. INBOUND_EMAIL_DOMAIN is the domain Postmark receives mail for;
# each workspace gets support-<slug>@<domain>, and replies are sent from it
# (so it must also be a verified sender domain in Postmark).
# Stock's bills addresses (bills-<token>@<domain>) use the same domain.
INBOUND_EMAIL_DOMAIN=
# A long random string you choose. Postmark's inbound webhook URL is then
# https://postmark:<this secret>@<site>/api/webhooks/postmark
POSTMARK_INBOUND_SECRET=
# Anthropic Console → API keys. Used for reply drafts and, on the worker as
# well as the web service, for reading bills by email (docs/bills-by-email.md).
ANTHROPIC_API_KEY=

# Worker only: set to "true" to delete workspaces 30 days after their plan
# ends. Leave unset until you've decided to turn deletion on.
ENABLE_TENANT_PURGE=
